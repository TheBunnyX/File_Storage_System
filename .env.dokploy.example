# Paste into Dokploy -> (Compose service) -> Environment, replacing every CHANGE_ME
# with a long random value (e.g. `openssl rand -hex 24`). Never commit real values.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Exact address people type in the browser. Without a domain: http://<server-ip>:<APP_PORT>.
# With a domain set in Dokploy's Domains tab (service "app", port 3008): https://files.example.com
APP_URL=http://localhost:3008
# Host port for direct IP access (must match the port in APP_URL when no domain is used).
APP_PORT=3008
# Real admin accounts (comma separated). They become Super Admin when they sign in.
NEXAFILE_ADMIN_EMAILS=
# Shared demo accounts (password shown on the login page). Demo accounts cannot sign in when this is false,
# so keep it true while imported files still belong to demo accounts (true for the current data).
NEXAFILE_DEMO=true
# Never true on a reachable site: it makes the shared demo Super Admin a full Super Admin.
NEXAFILE_DEMO_FULL_ADMIN=false
# DISABLE_REGISTRATION=true
# NEXAFILE_QUOTA_MB=1024
# NEXAFILE_MAX_UPLOAD_MB=50
