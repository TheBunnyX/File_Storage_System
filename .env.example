# Local cache, upload staging and encryption key directory.
# NEXAFILE_DATA_DIR=C:/nexafile-data
# Single-host storage budget per account, including all versions and trash.
NEXAFILE_QUOTA_MB=1024
NEXAFILE_MAX_UPLOAD_MB=50
# Files in Trash are deleted permanently after this many days (0 disables).
NEXAFILE_TRASH_RETENTION_DAYS=30
# Set the exact public origin behind a reverse proxy; use HTTPS for secure cookies.
# APP_URL=https://files.example.com
# DISABLE_REGISTRATION=true

# Demo login (off by default; shared credentials are displayed on the login page)
NEXAFILE_DEMO=false
# Never enable on a shared or public server: demo credentials are shown on the login page.
NEXAFILE_DEMO_FULL_ADMIN=false

# Primary service backends (SQLite/local are retained only for isolated tests and recovery).
# Local development uses the Docker stack published on 127.0.0.1 by docker-compose.dev.yml;
# copy the passwords and S3 keys from the Docker .env.
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3316
MYSQL_DATABASE=file_management
MYSQL_USER=appuser
MYSQL_PASSWORD=
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6390
REDIS_USERNAME=default
REDIS_PASSWORD=
# Redis uses numeric database IDs. Application isolation uses this key prefix.
REDIS_DB=0
REDIS_PREFIX=file_management:
BLOB_BACKEND=s3
S3_ENDPOINT=http://127.0.0.1:8343
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=backups
S3_PREFIX=file_management/

# Public product pages only. Keep indexing disabled until a real HTTPS domain is deployed.
SITE_URL=
SEO_INDEXING_ENABLED=false
