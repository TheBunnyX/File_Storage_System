# Copy to .env and replace every CHANGE_ME with a long random value
# (e.g. `openssl rand -hex 24`). Never commit .env.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Local development machine only: also publish MySQL/Redis/S3/ClamAV on 127.0.0.1 for `npm run dev`.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# APP_PORT=3008
# APP_URL=http://localhost:3008
# Show shared demo accounts on the login page (set false to hide)
# NEXAFILE_DEMO=true
